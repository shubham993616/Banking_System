# =============================================
# Local development — copy to .env and fill in values
# Never commit .env to git
# =============================================

# Database (local MySQL)
DB_URL=jdbc:mysql://localhost:3306/banking_accounts?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=

# Auth / admin bootstrap
ADMIN_EMAIL=your-admin@example.com
ADMIN_PASSWORD=change-me-strong-password
JWT_SECRET=generate-a-random-secret-at-least-32-characters-long

# Gmail SMTP (App Password)
MAIL_USERNAME=your@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# --- Production only (Render) ---
# SPRING_PROFILES_ACTIVE=prod
# PORT=8081
# CORS_ORIGIN_PATTERNS=https://your-app.vercel.app,https://*.vercel.app

# --- Production only (Vercel) ---
# API_BASE_URL=https://your-api.onrender.com
